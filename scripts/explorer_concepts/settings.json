{
  "output": "data/explorer-concepts.sqlite",
  "ui_config": "static/data/ui-config.json",
  "sound_label_prefix": "phoneme_",
  "sound_separator": " + ",
  "label_template": "{sounds} | {spelling}",
  "silent_label": "silent",
  "unmodeled_template": "{spelling} → {sounds}",
  "legacy_kind": "legacy",
  "kinds": {"phonogram": "phonogram", "blend": "blend", "silent": "silent", "unmodeled": "unmodeled", "unresolved": "unresolved"},
  "unresolved_label": "Excluded: unresolved analysis",
  "default_family": "phonogram_other_sounds",
  "sequence_family": "phonogram_sequences",
  "silent_family": "phonogram_silent",
  "unresolved_family": "phonogram_unresolved",
  "families": [
    {"id": "consonants", "label": "Single-letter consonants", "group": "Consonants", "collapsed": false, "lens": "phonograms"},
    {"id": "consonant_digraphs", "label": "Digraphs and other consonant spellings", "group": "Consonants", "collapsed": false, "lens": "phonograms"},
    {"id": "short_vowels", "label": "Short vowels", "group": "Vowels", "collapsed": false, "lens": "phonograms"},
    {"id": "long_vowels_single", "label": "Long vowels: single letter", "group": "Vowels", "collapsed": false, "lens": "phonograms"},
    {"id": "long_vowels_teams", "label": "Long vowels: vowel teams", "group": "Vowels", "collapsed": false, "lens": "phonograms"},
    {"id": "long_vowels_split", "label": "Long vowels: silent-e spellings", "group": "Vowels", "collapsed": false, "lens": "phonograms"},
    {"id": "diphthongs", "label": "Diphthongs", "group": "Vowels", "collapsed": false, "lens": "phonograms"},
    {"id": "r_controlled", "label": "R-controlled vowels", "group": "Vowels", "collapsed": false, "lens": "phonograms"},
    {"id": "schwa", "label": "Schwa", "group": "Vowels", "collapsed": false, "lens": "phonograms"},
    {"id": "phonogram_sequences", "label": "Two-sound spellings", "group": "Other spellings", "collapsed": false, "lens": "phonograms"},
    {"id": "phonogram_silent", "label": "Silent letters", "group": "Other spellings", "collapsed": true, "lens": "phonograms"},
    {"id": "phonogram_other_sounds", "label": "Other sound spellings", "group": "Other spellings", "collapsed": false, "lens": "phonograms"},
    {"id": "blends_initial_s", "label": "Initial s-blends", "group": "Blends", "collapsed": false, "lens": "phonograms"},
    {"id": "blends_initial_l", "label": "Initial l-blends", "group": "Blends", "collapsed": false, "lens": "phonograms"},
    {"id": "blends_initial_r", "label": "Initial r-blends", "group": "Blends", "collapsed": false, "lens": "phonograms"},
    {"id": "blends_initial_other", "label": "Other initial blends", "group": "Blends", "collapsed": false, "lens": "phonograms"},
    {"id": "blends_final", "label": "Final blends", "group": "Blends", "collapsed": false, "lens": "phonograms"},
    {"id": "phonogram_unresolved", "label": "Excluded words", "group": "Evidence", "collapsed": false, "lens": "phonograms"},
    {"id": "g_single", "label": "Single letters", "group": "Spellings", "collapsed": false, "lens": "graphemes"},
    {"id": "g_two", "label": "Two letters", "group": "Spellings", "collapsed": false, "lens": "graphemes"},
    {"id": "g_long", "label": "Three letters or more", "group": "Spellings", "collapsed": false, "lens": "graphemes"},
    {"id": "g_split", "label": "Split spellings", "group": "Spellings", "collapsed": false, "lens": "graphemes"},
    {"id": "p_consonants", "label": "Consonant sounds", "group": "Sounds", "collapsed": false, "lens": "phonemes"},
    {"id": "p_short", "label": "Short vowels", "group": "Sounds", "collapsed": false, "lens": "phonemes"},
    {"id": "p_long", "label": "Long vowels", "group": "Sounds", "collapsed": false, "lens": "phonemes"},
    {"id": "p_diphthongs", "label": "Diphthongs", "group": "Sounds", "collapsed": false, "lens": "phonemes"},
    {"id": "p_r_controlled", "label": "R-controlled vowels", "group": "Sounds", "collapsed": false, "lens": "phonemes"},
    {"id": "p_schwa", "label": "Schwa", "group": "Sounds", "collapsed": false, "lens": "phonemes"},
    {"id": "p_other", "label": "Other sounds", "group": "Sounds", "collapsed": false, "lens": "phonemes"}
  ],
  "reason_labels": {
    "missing_alignment": "There is no letter-to-sound data for it.",
    "spelling_mismatch": "Its letters don't match the letter-to-sound data.",
    "pronunciation_mismatch": "We couldn't match its pronunciation to its spelling.",
    "unknown_phoneme": "It contains a sound we don't recognise.",
    "unsupported_spelling": "Its spelling has an apostrophe, hyphen or other non-letter.",
    "syllable_reconstruction": "The written division does not rebuild the spelling",
    "syllable_count": "The written division has a different number of syllables than the sounds",
    "syllable_boundary": "A phonogram crosses the written syllable break (for example the pp in hap|py)",
    "incomplete_coverage": "Some letters or sounds aren't accounted for.",
    "initialism_or_abbreviation": "It is an initialism or abbreviation, so it isn't built from regular letter-sound patterns."
  },
  "ui_category_families": {"consonants": "consonants", "short": "short_vowels", "long": "long_vowels"},
  "vowel_categories": {"diphthong": ["ow", "oy", "aw"], "r_controlled": ["ar", "or", "er", "air", "ear"], "schwa": ["schwa"]},
  "notation_source": "DecodifyWebsite/src/content/phonogram-review.json",
  "notation_prefix": "sound_",
  "split_marker": "_",
  "family_rules": [
    {"category": "consonants", "shape": "single", "family": "consonants"},
    {"category": "consonants", "family": "consonant_digraphs"},
    {"category": "short", "family": "short_vowels"},
    {"category": "long", "shape": "single", "family": "long_vowels_single"},
    {"category": "long", "shape": "multi", "family": "long_vowels_teams"},
    {"category": "long", "shape": "split", "family": "long_vowels_split"},
    {"category": "diphthong", "family": "diphthongs"},
    {"category": "r_controlled", "family": "r_controlled"},
    {"category": "schwa", "family": "schwa"}
  ],
  "blend_rules": [
    {"context": "final", "family": "blends_final"},
    {"context": "initial", "spelling_pattern": "^s", "family": "blends_initial_s"},
    {"context": "initial", "spelling_pattern": "l$", "family": "blends_initial_l"},
    {"context": "initial", "spelling_pattern": "r$", "family": "blends_initial_r"},
    {"context": "initial", "family": "blends_initial_other"}
  ],
  "group_order": ["Consonants", "Vowels", "Other spellings", "Spellings", "Sounds", "Blends", "Patterns", "Structure", "Morphology", "Spelling rules", "Evidence"],
  "facets": {
    "prefixes": {"grapheme": "g:", "phoneme": "p:"},
    "kinds": {"grapheme": "grapheme", "phoneme": "phoneme"},
    "source_kinds": ["phonogram", "unmodeled"],
    "grapheme_rules": [
      {"shape": "split", "family": "g_split"},
      {"max_length": 1, "family": "g_single"},
      {"max_length": 2, "family": "g_two"},
      {"family": "g_long"}
    ],
    "phoneme_families": {"consonants": "p_consonants", "short": "p_short", "long": "p_long", "diphthong": "p_diphthongs", "r_controlled": "p_r_controlled", "schwa": "p_schwa"},
    "default_phoneme_family": "p_other"
  },
  "heteronyms_path": "data/mappings/heteronyms.json",
  "heteronym_link": "https://en.wiktionary.org/wiki/{word}",
  "selected_source": "selected",
  "heteronym_confidence": {"confirmed": "confirmed", "listed": "listed"},
  "redundant_reasons": {"pronunciation_mismatch": ["incomplete_coverage"]},
  "origins_path": "data/mappings/word-origins.json",
  "rarity_kinds": ["phonogram", "unmodeled"]
}
