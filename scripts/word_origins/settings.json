    "wordnet_files": ["noun", "verb", "adj", "adv"],
    "wordnet_member": "wordnet/data.{}",
    "acronym_minimum_letters": 2,
    "suffix_strips": ["s", "es", "ed", "d", "ing", "er", "ers", "ly"],
    "kinds": {"census_surnames": "surname", "first_names": "first_name", "places": "place", "wordnet_proper": "wordnet_proper"},
    "proper_flag": "proper_noun",
    "acronym_flag": "acronym",
    "wordnet_exceptions": "wordnet/{}.exc",
    "closed_class": ["since", "per", "oh", "else", "hey", "wanna", "gotta", "shall", "via", "toward", "ya", "ah", "ha", "pre", "app", "ok", "yeah", "yes", "um", "uh", "gonna", "whom", "whose", "unto", "upon", "hmm"],
    "mixed_flag": "name_sense",
    "source_labels": ["wiktionary", "wordnet_proper", "wordnet", "acronym"],
    "acronym_mixed_flag": "acronym_sense"
  },
