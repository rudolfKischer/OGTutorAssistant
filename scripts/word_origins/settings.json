  "definitions": {
    "database": "data/words.db",
    "flag_value": "definition",
    "patterns": {
      "surname": "\\b(surname|last name|family name|patronymic)\\b",
      "given_name": "\\b((male|female|unisex|masculine|feminine)?\\s*(given|first) name|diminutive of .{0,40}name|short form of .{0,30}name|form of the (male|female))\\b",
      "place": "^(?i:(?:an? |the )?(?:[a-z-]+ ){0,2}(?:unincorporated community|census-designated place|city|town|village|hamlet|municipality|capital|county|state|province|region|river|lake|mountain|island|country|borough|suburb|neighbou?rhood|district|township|commune|parish|department|prefecture|settlement|locality)(?: and (?:an? |the )?[a-z -]{0,40})?,?) (?i:in|of|on|near|within) (?:the )?[A-Z]"
    },
    "case_sensitive_kinds": ["place"],
    "abbreviation_start": "^(abbreviation|initialism) of\\b",
    "acronym_words": "\\b(acronym|initialism)\\b",
    "abbreviation_like": "^(abbreviation|initialism|acronym|clipping|contraction|symbol|short form|shortened form|alternative form|misspelling|alternative letter-case form) (of|for)\\b",
    "origin_patterns": [
      "\\b(?:surname|given name|first name|family name|name)\\b[^.]{0,20}?\\b(?:from|of|in|derived from)\\s+(?:the\\s+)?([A-Z][A-Za-z-]+(?: [A-Z][A-Za-z-]+)?)",
      "^(?:An?|The)\\s+([A-Z][A-Za-z-]+(?: [A-Z][A-Za-z-]+)?)\\s+(?:surname|given name|male given name|female given name|family name|name)\\b"
    ],
    "origin_skip": ["English", "Old English", "Middle English", "American", "British", "Anglo-Norman", "Norman", "Germanic", "Celtic", "Latin", "Ancient Greek", "Old French", "Old Norse", "Scottish", "Jewish", "The", "Biblical"]
  },
  "rare_context_count": 2,
  "start_marker": "^",
  "silent_context_template": "{letter} silent after {previous}",
  "silent_start_template": "{letter} silent at the start",
